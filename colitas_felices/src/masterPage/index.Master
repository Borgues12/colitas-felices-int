<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="index.Master.cs" Inherits="colitas_felices.index" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <asp:ContentPlaceHolder ID="TituloPlaceHolder" runat="server">
            Colitas Felices - Refugio de Animales
       
        </asp:ContentPlaceHolder>
    </title>

    <%-- ======================================================
         FUENTES — Google Fonts
         - Playfair Display: para títulos grandes (hero, secciones)
         - Nunito: para todo el texto de UI y cuerpo
    ======================================================= --%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Mogra:wght@400;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">

    <%-- ======================================================
         ÍCONOS — Font Awesome
         Va antes de Bootstrap para que los íconos dentro de
         los componentes de Bootstrap se vean desde el inicio
    ======================================================= --%>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <%-- ======================================================
         BOOTSTRAP 5 — Solo el CSS aquí en el head
         El JS de Bootstrap va al final del body (más abajo).
    ======================================================= --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%-- ======================================================
         NOTYF — CSS de las notificaciones
    ======================================================= --%>
    <link href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" rel="stylesheet">

    <%-- ======================================================
         ESTILOS PROPIOS — Un solo link, todo organizado adentro
         
         start_styles.css importa en orden:
           1. variables.css        (colores, fuentes, espaciado)
           2. bootstrap_overrides  (sobreescribe colores de Bootstrap)
           3. reset.css            (normalización propia)
           4. global.css           (estilos base del sitio)
           5. loader.css           (animación de carga)
           6. navbar.css           (componente navbar)
           7. footer.css           (componente footer)
         
        
    ======================================================= --%>
    <link rel="stylesheet" href="~/src/css/base_styles.css">

    <%-- ======================================================
         ICONIFY — íconos adicionales (ya lo tenías)
    ======================================================= --%>
    <script defer src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <%-- Espacio para CSS adicional de cada página --%>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form" runat="server">

        <%-- PRELOADER — solo se muestra en la primera visita --%>
        <div id="preloader">
            <div class="loader"></div>
        </div>

        <%-- ======================================================
             NAVBAR
             Sin cambios en estructura — los estilos van a navbar.css
        ======================================================= --%>
        <nav class="navbar-cf" id="navbar">
            <div class="navbar-cf__container">

                <a href='<%=ResolveUrl("~/principal") %>' class="navbar-cf__logo">
                    <img src='<%=ResolveUrl("~/src/images/logo_pagina_rosa.jpeg") %>'
                        alt="Colitas Felices" class="navbar-cf__logo-img" />
                </a>

                <ul class="navbar-cf__menu" id="navMenu">
                    <li class="navbar-cf__item">
                        <a href='<%=ResolveUrl("~/principal") %>' class="navbar-cf__link">
                            <i class="fas fa-home"></i>Inicio
                        </a>
                    </li>

                    <li class="navbar-cf__item navbar-cf__item--dropdown">
                        <a href="#" class="navbar-cf__link">
                            <i class="fas fa-heart"></i>Adopta
                           
                            <i class="fas fa-chevron-down navbar-cf__arrow"></i>
                        </a>
                        <ul class="navbar-cf__dropdown">
                            <li><a href='<%=ResolveUrl("~/adopta") %>'>Ver Mascotas</a></li>
                            <li><a href='<%=ResolveUrl("~/adopta") %>'>Proceso de Adopción</a></li>
                            <li><a href='<%=ResolveUrl("~/adopta") %>'>Requisitos</a></li>
                        </ul>
                    </li>

                    <li class="navbar-cf__item navbar-cf__item--dropdown">
                        <a href="#" class="navbar-cf__link">
                            <i class="fas fa-users"></i>Nosotros
                           
                            <i class="fas fa-chevron-down navbar-cf__arrow"></i>
                        </a>
                        <ul class="navbar-cf__dropdown">
                            <li><a href='<%=ResolveUrl("~/nosotros") %>'>¿Quiénes Somos?</a></li>
                            <li><a href='<%=ResolveUrl("~/nosotros") %>'>Nuestra Historia</a></li>
                            <li><a href='<%=ResolveUrl("~/nosotros") %>'>Nuestro Equipo</a></li>
                        </ul>
                    </li>

                    <li class="navbar-cf__item navbar-cf__item--dropdown">
                        <a href="#" class="navbar-cf__link">
                            <i class="fas fa-hand-holding-heart"></i>Ayúdanos
                           
                            <i class="fas fa-chevron-down navbar-cf__arrow"></i>
                        </a>
                        <ul class="navbar-cf__dropdown">
                            <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Donar</a></li>
                            <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Apadrinar</a></li>
                            <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Voluntariado</a></li>
                            <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Tienda Solidaria</a></li>
                        </ul>
                    </li>

                    <li class="navbar-cf__item">
                        <a href='<%=ResolveUrl("~/perdidos") %>' class="navbar-cf__link">
                            <i class="fas fa-search"></i>Perdidos
                        </a>
                    </li>
                </ul>

                <div class="navbar-cf__auth">
                    <asp:Panel ID="pnlNoLogueado" runat="server">
                        <a href='<%=ResolveUrl("~/iniciar_sesion") %>' class="navbar-cf__btn-login">
                            <i class="fas fa-user"></i>Iniciar Sesión
                        </a>
                    </asp:Panel>

                    <asp:Panel ID="pnlLogueado" runat="server" Visible="false" CssClass="navbar-cf__user-menu">
                        <div class="navbar-cf__user-dropdown" id="userDropdown">
                            <button type="button" class="navbar-cf__btn-user">
                                <asp:Image ID="imgFotoPerfil" runat="server" CssClass="navbar-cf__avatar" />
                                <span>
                                    <asp:Literal ID="litNombreUsuario" runat="server"></asp:Literal></span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <ul class="navbar-cf__user-options">
                                <li><a href="#"><i class="fas fa-user-circle"></i>Mi Perfil</a></li>
                                <li><a href="#"><i class="fas fa-file-alt"></i>Mis Solicitudes</a></li>
                                <li><a href="#"><i class="fas fa-heart"></i>Mis Donaciones</a></li>
                                <li class="navbar-cf__divider"></li>
                                <li>
                                    <asp:LinkButton ID="btnCerrarSesion" runat="server"
                                        OnClick="btnCerrarSesion_Click"
                                        CssClass="navbar-cf__logout">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                    </asp:LinkButton>
                                </li>
                            </ul>
                        </div>
                    </asp:Panel>
                </div>

                <button class="navbar-cf__toggle" id="navToggle" type="button"
                    aria-label="Abrir menú" aria-expanded="false">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>

        <%-- Contenido de cada página va aquí --%>
        <main>
            <asp:ContentPlaceHolder ID="body" runat="server"></asp:ContentPlaceHolder>
        </main>

        <%-- ======================================================
             FOOTER
        ======================================================= --%>
        <footer class="footer-cf">
            <div class="footer-cf__container">
                <div class="footer-cf__col">
                    <h4 class="footer-cf__title">Colitas Felices</h4>
                    <p class="footer-cf__text">15 años rescatando y encontrando hogares para animales en Quito.</p>
                    <div class="footer-cf__social">
                        <a href="#" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" target="_blank" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                        <a href="#" target="_blank" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>

                <div class="footer-cf__col">
                    <h4 class="footer-cf__title">Enlaces Rápidos</h4>
                    <ul class="footer-cf__list">
                        <li><a href='<%=ResolveUrl("~/adopta") %>'>Adoptar</a></li>
                        <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Donar</a></li>
                        <li><a href='<%=ResolveUrl("~/voluntariado") %>'>Voluntariado</a></li>
                        <li><a href='<%=ResolveUrl("~/perdidos") %>'>Animales Perdidos</a></li>
                    </ul>
                </div>

                <div class="footer-cf__col">
                    <h4 class="footer-cf__title">Contacto</h4>
                    <ul class="footer-cf__list footer-cf__list--contact">
                        <li><i class="fas fa-map-marker-alt"></i>Calderón, Quito - Ecuador</li>
                        <li><i class="fas fa-phone"></i>+593 99 XXX XXXX</li>
                        <li><i class="fas fa-envelope"></i>info@colitasfelices.org</li>
                    </ul>
                </div>

                <div class="footer-cf__col">
                    <h4 class="footer-cf__title">Horarios de Visita</h4>
                    <ul class="footer-cf__list">
                        <li>Lunes a Viernes: 9:00 - 17:00</li>
                        <li>Sábados: 10:00 - 14:00</li>
                        <li>Domingos: Cerrado</li>
                    </ul>
                </div>
            </div>

            <div class="footer-cf__bottom">
                <p>&copy; <%= DateTime.Now.Year %> Colitas Felices. Todos los derechos reservados.</p>
            </div>
        </footer>

        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

    </form>
    <%-- Cierre del form ASP.NET --%>

    <%-- ======================================================
         SCRIPTS — Siempre al final del body
         
         Orden importante:
           1. jQuery (otros scripts pueden depender de él)
           2. Bootstrap JS (necesita estar en el DOM completo)
           3. Notyf JS
           4. Scripts propios
           5. Scripts de cada página (placeholder al último)
         
         ¿Por qué al final del body y no en el head?
         El navegador lee HTML de arriba hacia abajo. Si un
         script está en el <head>, bloquea el renderizado hasta
         terminar de descargarlo y ejecutarlo. Al final del body,
         el usuario ya ve la página mientras los scripts cargan.
    ======================================================= --%>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script src='<%=ResolveUrl("~/src/js/loader.js") %>'></script>

    <script>
        // --------------------------------------------------
        // Notyf — inicialización global
        // Al estar aquí, la variable 'notyf' está disponible
        // en cualquier página que herede esta MasterPage.
        // Uso desde cualquier .aspx: notyf.success('mensaje')
        // --------------------------------------------------
        var notyf = new Notyf({
            duration: 4000,
            position: { x: 'right', y: 'top' },
            dismissible: true,
            ripple: true
        });

        // --------------------------------------------------
        // Navbar — menú hamburguesa (móvil)
        // --------------------------------------------------
        var navToggle = document.getElementById('navToggle');
        var navMenu = document.getElementById('navMenu');

        navToggle.addEventListener('click', function () {
            var isOpen = navMenu.classList.toggle('navbar-cf__menu--open');
            this.classList.toggle('navbar-cf__toggle--active');
            this.setAttribute('aria-expanded', isOpen);
        });

        // --------------------------------------------------
        // Navbar — dropdowns en móvil
        // En desktop se manejan por CSS (:hover)
        // En móvil necesitamos click porque no hay hover
        // --------------------------------------------------
        document.querySelectorAll('.navbar-cf__item--dropdown > .navbar-cf__link')
            .forEach(function (link) {
                link.addEventListener('click', function (e) {
                    if (window.innerWidth <= 991) {
                        e.preventDefault();
                        this.parentElement.classList.toggle('navbar-cf__item--open');
                    }
                });
            });

        // --------------------------------------------------
        // Navbar — dropdown del usuario logueado (desaparece si no)
        // --------------------------------------------------
        var userDropdown = document.getElementById('userDropdown');
        if (userDropdown) {
            userDropdown.querySelector('.navbar-cf__btn-user')
                .addEventListener('click', function (e) {
                    e.preventDefault();
                    userDropdown.classList.toggle('navbar-cf__user-dropdown--open');
                });

            // Cerrar al hacer click fuera
            document.addEventListener('click', function (e) {
                if (!userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('navbar-cf__user-dropdown--open');
                }
            });
        }

        // --------------------------------------------------
        // Navbar — efecto scroll: agrega sombra al bajar
        // --------------------------------------------------
        window.addEventListener('scroll', function () {
            document.getElementById('navbar')
                .classList.toggle('navbar-cf--scrolled', window.scrollY > 20);
        });
    </script>

    <%-- Scripts adicionales de cada página --%>
    <asp:ContentPlaceHolder ID="scripts" runat="server"></asp:ContentPlaceHolder>

</body>
</html>
